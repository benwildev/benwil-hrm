generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==================== Company ====================

model Company {
  id                String   @id @default("singleton")
  name              String   @default("My Company")
  legalName         String?  @map("legal_name")
  logoUrl           String?  @map("logo_url")
  addressLine       String?  @map("address_line")
  city              String?
  state             String?
  country           String?
  postalCode        String?  @map("postal_code")
  phone             String?
  email             String?
  taxId             String?  @map("tax_id")
  primaryColor      String   @default("oklch(0.205 0 0)") @map("primary_color")
  primaryForeground String   @default("oklch(0.985 0 0)") @map("primary_foreground")
  accentColor       String   @default("oklch(0.97 0 0)") @map("accent_color")
  accentForeground  String   @default("oklch(0.205 0 0)") @map("accent_foreground")
  sidebarPrimary    String   @default("oklch(0.205 0 0)") @map("sidebar_primary")
  sidebarAccent     String   @default("oklch(0.97 0 0)") @map("sidebar_accent")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("companies")
}

// ==================== RBAC ====================

model Role {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String           @unique
  group       String
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ==================== Auth (login identity only) ====================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String     @unique
  passwordHash String     @map("password_hash")
  roleId       String     @map("role_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id])
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  employee Employee?
  accounts Account[]
  sessions Session[]

  adjustmentsMade AttendanceAdjustment[] @relation("AdjustedBy")
  leaveReviews    LeaveRequest[]         @relation("ReviewedBy")
  payrollsRun     PayrollPeriod[]        @relation("ProcessedBy")

  @@map("users")
}

model Account {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ==================== Organization ====================

model Department {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  employees Employee[]

  @@map("departments")
}

model Designation {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  employees Employee[]

  @@map("designations")
}

model Shift {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String
  startTime            DateTime @map("start_time") @db.Time
  endTime              DateTime @map("end_time") @db.Time
  gracePeriodMinutes   Int      @default(0) @map("grace_period_minutes")
  requiredWorkMinutes  Int?     @map("required_work_minutes")
  breakMinutes         Int      @default(0) @map("break_minutes")
  isOvernight          Boolean  @default(false) @map("is_overnight")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  employees        Employee[]
  attendanceRecords AttendanceRecord[]

  @@map("shifts")
}

model Holiday {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date               DateTime @db.Date
  name               String
  isRecurringYearly  Boolean  @default(false) @map("is_recurring_yearly")
  createdAt          DateTime @default(now()) @map("created_at")

  @@map("holidays")
}

// ==================== Employee ====================

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  RESIGNED
  TERMINATED
  INACTIVE
}

model Employee {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeCode     String  @unique @map("employee_code")
  fullName         String  @map("full_name")
  profilePhotoUrl  String? @map("profile_photo_url")

  dateOfBirth   DateTime? @map("date_of_birth") @db.Date
  gender        String?
  maritalStatus String?   @map("marital_status")
  nationality   String?
  bloodGroup    String?   @map("blood_group")

  personalEmail   String? @map("personal_email")
  workEmail       String? @map("work_email")
  phone           String?
  alternatePhone  String? @map("alternate_phone")

  presentAddress   String? @map("present_address") @db.Text
  permanentAddress String? @map("permanent_address") @db.Text

  emergencyContactName         String? @map("emergency_contact_name")
  emergencyContactRelationship String? @map("emergency_contact_relationship")
  emergencyContactPhone        String? @map("emergency_contact_phone")

  joiningDate      DateTime         @map("joining_date") @db.Date
  employmentType   EmploymentType?  @map("employment_type")
  employmentStatus EmploymentStatus @default(ACTIVE) @map("employment_status")

  departmentId String?      @map("department_id") @db.Uuid
  department   Department?  @relation(fields: [departmentId], references: [id])

  designationId String?      @map("designation_id") @db.Uuid
  designation   Designation? @relation(fields: [designationId], references: [id])

  shiftId String? @map("shift_id") @db.Uuid
  shift   Shift?  @relation(fields: [shiftId], references: [id])

  reportingManagerId String?    @map("reporting_manager_id") @db.Uuid
  reportingManager    Employee?  @relation("EmployeeManager", fields: [reportingManagerId], references: [id])
  directReports       Employee[] @relation("EmployeeManager")

  resignationDate DateTime? @map("resignation_date") @db.Date
  terminationDate DateTime? @map("termination_date") @db.Date
  exitReason      String?   @map("exit_reason") @db.Text

  userId String? @unique @map("user_id") @db.Uuid
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  documents             EmployeeDocument[]
  biometricLogs         BiometricLog[]
  attendanceRecords     AttendanceRecord[]
  attendanceAdjustments AttendanceAdjustment[]
  leaveBalances         EmployeeLeaveBalance[]
  leaveRequests         LeaveRequest[]
  salaries              EmployeeSalary[]
  salaryComponents      EmployeeSalaryComponent[]
  payrollRecords        PayrollRecord[]

  @@map("employees")
}

model EmployeeDocument {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId   String   @map("employee_id") @db.Uuid
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  documentType String   @map("document_type")
  documentName String   @map("document_name")
  fileUrl      String   @map("file_url") @db.Text
  notes        String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("employee_documents")
}

// ==================== Biometric ====================

model BiometricDevice {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deviceName       String    @map("device_name")
  deviceType       String?   @map("device_type")
  deviceIdentifier String?   @map("device_identifier")
  ipAddress        String?   @map("ip_address")
  locationName     String?   @map("location_name")
  status           String    @default("active")
  lastSyncAt       DateTime? @map("last_sync_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  logs BiometricLog[]

  @@map("biometric_devices")
}

enum PunchType {
  CHECK_IN
  CHECK_OUT
  UNKNOWN
}

model BiometricLog {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId       String?          @map("employee_id") @db.Uuid
  employee         Employee?        @relation(fields: [employeeId], references: [id])
  deviceId         String?          @map("device_id") @db.Uuid
  device           BiometricDevice? @relation(fields: [deviceId], references: [id])
  biometricUserId  String?          @map("biometric_user_id")
  punchTime        DateTime         @map("punch_time")
  punchType        PunchType        @default(UNKNOWN) @map("punch_type")
  rawData          Json?            @map("raw_data")
  createdAt        DateTime         @default(now()) @map("created_at")

  @@index([employeeId, punchTime])
  @@map("biometric_logs")
}

// ==================== Attendance ====================

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  LEAVE
  HOLIDAY
  WEEKEND
}

enum AttendanceSource {
  BIOMETRIC
  MANUAL
  SYSTEM
}

model AttendanceRecord {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftId    String?  @map("shift_id") @db.Uuid
  shift      Shift?   @relation(fields: [shiftId], references: [id])

  attendanceDate DateTime @map("attendance_date") @db.Date

  checkIn  DateTime? @map("check_in")
  checkOut DateTime? @map("check_out")

  workMinutes       Int @default(0) @map("work_minutes")
  lateMinutes       Int @default(0) @map("late_minutes")
  earlyLeaveMinutes Int @default(0) @map("early_leave_minutes")
  overtimeMinutes   Int @default(0) @map("overtime_minutes")

  status AttendanceStatus @default(ABSENT)

  checkInSource  AttendanceSource? @map("check_in_source")
  checkOutSource AttendanceSource? @map("check_out_source")

  notes String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  adjustments AttendanceAdjustment[]

  @@unique([employeeId, attendanceDate])
  @@map("attendance_records")
}

model AttendanceAdjustment {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attendanceId String         @map("attendance_id") @db.Uuid
  attendance AttendanceRecord @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  employeeId String           @map("employee_id") @db.Uuid
  employee   Employee         @relation(fields: [employeeId], references: [id])

  oldCheckIn  DateTime? @map("old_check_in")
  oldCheckOut DateTime? @map("old_check_out")
  newCheckIn  DateTime? @map("new_check_in")
  newCheckOut DateTime? @map("new_check_out")

  reason String @db.Text

  adjustedById String? @map("adjusted_by") @db.Uuid
  adjustedBy   User?   @relation("AdjustedBy", fields: [adjustedById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@map("attendance_adjustments")
}

// ==================== Leave ====================

model LeaveType {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String   @unique
  description  String?
  daysPerYear  Decimal? @map("days_per_year") @db.Decimal(5, 2)
  isPaid       Boolean  @default(true) @map("is_paid")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  balances EmployeeLeaveBalance[]
  requests LeaveRequest[]

  @@map("leave_types")
}

model EmployeeLeaveBalance {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId String  @map("leave_type_id") @db.Uuid
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])

  year Int

  allocatedDays  Decimal @default(0) @map("allocated_days") @db.Decimal(5, 2)
  usedDays       Decimal @default(0) @map("used_days") @db.Decimal(5, 2)
  remainingDays  Decimal @default(0) @map("remaining_days") @db.Decimal(5, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([employeeId, leaveTypeId, year])
  @@map("employee_leave_balances")
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId String    @map("employee_id") @db.Uuid
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId String   @map("leave_type_id") @db.Uuid
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])

  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  totalDays Decimal  @map("total_days") @db.Decimal(5, 2)

  reason        String? @db.Text
  attachmentUrl String? @map("attachment_url") @db.Text

  status LeaveStatus @default(PENDING)

  reviewedById String?   @map("reviewed_by") @db.Uuid
  reviewedBy   User?     @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime? @map("reviewed_at")
  reviewNote   String?   @map("review_note") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("leave_requests")
}

// ==================== Salary ====================

enum PaymentFrequency {
  MONTHLY
  BIWEEKLY
  WEEKLY
}

model EmployeeSalary {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  basicSalary Decimal @map("basic_salary") @db.Decimal(12, 2)

  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  paymentFrequency PaymentFrequency @default(MONTHLY) @map("payment_frequency")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("employee_salaries")
}

enum ComponentType {
  EARNING
  DEDUCTION
}

enum CalculationType {
  FIXED
  PERCENTAGE
}

model SalaryComponent {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  componentType    ComponentType   @map("component_type")
  calculationType  CalculationType @default(FIXED) @map("calculation_type")
  defaultAmount    Decimal         @default(0) @map("default_amount") @db.Decimal(12, 2)
  isActive         Boolean         @default(true) @map("is_active")
  createdAt        DateTime        @default(now()) @map("created_at")

  employeeComponents EmployeeSalaryComponent[]

  @@map("salary_components")
}

model EmployeeSalaryComponent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  salaryComponentId String          @map("salary_component_id") @db.Uuid
  salaryComponent   SalaryComponent @relation(fields: [salaryComponentId], references: [id])

  amount Decimal @db.Decimal(12, 2)

  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  createdAt DateTime @default(now()) @map("created_at")

  @@map("employee_salary_components")
}

// ==================== Payroll ====================

enum PayrollPeriodStatus {
  DRAFT
  PROCESSING
  COMPLETED
  LOCKED
}

model PayrollPeriod {
  id    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  year  Int
  month Int

  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date

  status PayrollPeriodStatus @default(DRAFT)

  processedAt   DateTime? @map("processed_at")
  processedById String?   @map("processed_by") @db.Uuid
  processedBy   User?     @relation("ProcessedBy", fields: [processedById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  records PayrollRecord[]

  @@unique([year, month])
  @@map("payroll_periods")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

model PayrollRecord {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payrollPeriodId String        @map("payroll_period_id") @db.Uuid
  payrollPeriod   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  employeeId      String        @map("employee_id") @db.Uuid
  employee        Employee      @relation(fields: [employeeId], references: [id])

  basicSalary      Decimal @default(0) @map("basic_salary") @db.Decimal(12, 2)
  totalEarnings    Decimal @default(0) @map("total_earnings") @db.Decimal(12, 2)
  totalDeductions  Decimal @default(0) @map("total_deductions") @db.Decimal(12, 2)
  overtimeAmount   Decimal @default(0) @map("overtime_amount") @db.Decimal(12, 2)
  bonusAmount      Decimal @default(0) @map("bonus_amount") @db.Decimal(12, 2)
  netSalary        Decimal @default(0) @map("net_salary") @db.Decimal(12, 2)

  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  paidAt        DateTime?     @map("paid_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items   PayrollItem[]
  payslip Payslip?

  @@unique([payrollPeriodId, employeeId])
  @@map("payroll_records")
}

model PayrollItem {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payrollRecordId String        @map("payroll_record_id") @db.Uuid
  payrollRecord   PayrollRecord @relation(fields: [payrollRecordId], references: [id], onDelete: Cascade)

  name        String
  type        ComponentType
  amount      Decimal       @db.Decimal(12, 2)
  description String?       @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  @@map("payroll_items")
}

model Payslip {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payrollRecordId String        @unique @map("payroll_record_id") @db.Uuid
  payrollRecord   PayrollRecord @relation(fields: [payrollRecordId], references: [id], onDelete: Cascade)

  payslipNumber String   @unique @map("payslip_number")
  fileUrl       String?  @map("file_url") @db.Text
  generatedAt   DateTime @default(now()) @map("generated_at")

  @@map("payslips")
}
