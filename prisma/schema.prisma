generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model accounts {
  id                  String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String  @db.Uuid
  type                String
  provider            String
  provider_account_id String
  refresh_token       String?
  access_token        String?
  expires_at          Int?
  token_type          String?
  scope               String?
  id_token            String?
  session_state       String?
  users               users   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_account_id])
  @@index([user_id])
}

model attendance_adjustments {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attendance_id      String             @db.Uuid
  employee_id        String             @db.Uuid
  old_check_in       DateTime?
  old_check_out      DateTime?
  new_check_in       DateTime?
  new_check_out      DateTime?
  reason             String
  adjusted_by        String?            @db.Uuid
  created_at         DateTime           @default(now())
  users              users?             @relation(fields: [adjusted_by], references: [id])
  attendance_records attendance_records @relation(fields: [attendance_id], references: [id], onDelete: Cascade)
  employees          employees          @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@index([attendance_id])
  @@index([employee_id])
}

model attendance_records {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id            String                   @db.Uuid
  shift_id               String?                  @db.Uuid
  attendance_date        DateTime                 @db.Date
  check_in               DateTime?
  check_out              DateTime?
  work_minutes           Int                      @default(0)
  late_minutes           Int                      @default(0)
  early_leave_minutes    Int                      @default(0)
  overtime_minutes       Int                      @default(0)
  status                 AttendanceStatus         @default(ABSENT)
  check_in_source        AttendanceSource?
  check_out_source       AttendanceSource?
  notes                  String?
  created_at             DateTime                 @default(now())
  updated_at             DateTime
  attendance_adjustments attendance_adjustments[]
  employees              employees                @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  shifts                 shifts?                  @relation(fields: [shift_id], references: [id])

  @@unique([employee_id, attendance_date])
  @@index([attendance_date])
  @@index([check_in])
  @@index([shift_id])
  @@index([status, attendance_date])
}

model audit_logs {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String?  @db.Uuid
  action      String
  entity_type String
  entity_id   String?
  old_data    Json?
  new_data    Json?
  ip_address  String?
  user_agent  String?
  created_at  DateTime @default(now())
  users       users?   @relation(fields: [user_id], references: [id])

  @@index([action])
  @@index([created_at])
  @@index([entity_type, entity_id])
  @@index([user_id, created_at])
}

model biometric_devices {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  device_name       String
  device_type       String?
  device_identifier String           @unique
  ip_address        String?
  location_name     String?
  status            String           @default("active")
  last_sync_at      DateTime?
  created_at        DateTime         @default(now())
  updated_at        DateTime
  api_key           String?          @unique
  biometric_logs    biometric_logs[]
}

model biometric_logs {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id       String?            @db.Uuid
  device_id         String?            @db.Uuid
  biometric_user_id String?
  punch_time        DateTime
  punch_type        PunchType          @default(UNKNOWN)
  raw_data          Json?
  created_at        DateTime           @default(now())
  device_event_id   String?
  is_processed      Boolean            @default(false)
  processed_at      DateTime?
  biometric_devices biometric_devices? @relation(fields: [device_id], references: [id])
  employees         employees?         @relation(fields: [employee_id], references: [id])

  @@unique([device_id, device_event_id])
  @@index([device_id, punch_time])
  @@index([employee_id, punch_time])
  @@index([is_processed, punch_time])
}

model companies {
  id                        String   @id @default("singleton")
  name                      String   @default("My Company")
  legal_name                String?
  logo_url                  String?
  address_line              String?
  city                      String?
  state                     String?
  country                   String?
  postal_code               String?
  phone                     String?
  email                     String?
  tax_id                    String?
  primary_color             String   @default("oklch(0.205 0 0)")
  primary_foreground        String   @default("oklch(0.985 0 0)")
  accent_color              String   @default("oklch(0.97 0 0)")
  accent_foreground         String   @default("oklch(0.205 0 0)")
  sidebar_primary           String   @default("oklch(0.205 0 0)")
  sidebar_accent            String   @default("oklch(0.97 0 0)")
  created_at                DateTime @default(now())
  updated_at                DateTime
  absence_calculation_basis String   @default("WORKING_DAYS")
  absence_deduction_rate    Decimal  @default(100) @db.Decimal(5, 2)
  enable_absence_deduction  Boolean  @default(true)
  enable_late_deduction     Boolean  @default(false)
  late_deduction_basis      String   @default("ONE_DAY_PER_3_LATES")
  late_deduction_rate       Decimal  @default(100) @db.Decimal(5, 2)
  late_grace_count          Int      @default(3)
  timezone                  String   @default("UTC")
  weekend_days              String   @default("0,6")
}

model departments {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String      @unique
  description String?
  created_at  DateTime    @default(now())
  updated_at  DateTime
  employees   employees[]
}

model designations {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String      @unique
  description String?
  created_at  DateTime    @default(now())
  updated_at  DateTime
  employees   employees[]
}

model employee_documents {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id   String    @db.Uuid
  document_type String
  document_name String
  file_url      String
  notes         String?
  created_at    DateTime  @default(now())
  updated_at    DateTime
  employees     employees @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@index([employee_id])
}

model employee_leave_balances {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id    String      @db.Uuid
  leave_type_id  String      @db.Uuid
  year           Int
  allocated_days Decimal     @default(0) @db.Decimal(5, 2)
  used_days      Decimal     @default(0) @db.Decimal(5, 2)
  remaining_days Decimal     @default(0) @db.Decimal(5, 2)
  created_at     DateTime    @default(now())
  updated_at     DateTime
  employees      employees   @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  leave_types    leave_types @relation(fields: [leave_type_id], references: [id], onDelete: Cascade)

  @@unique([employee_id, leave_type_id, year])
  @@index([employee_id, year])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model employee_salaries {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id       String           @db.Uuid
  basic_salary      Decimal          @db.Decimal(12, 2)
  effective_from    DateTime         @db.Date
  effective_to      DateTime?        @db.Date
  payment_frequency PaymentFrequency @default(MONTHLY)
  created_at        DateTime         @default(now())
  updated_at        DateTime
  employees         employees        @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@index([employee_id, effective_from])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model employee_salary_components {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id         String            @db.Uuid
  salary_component_id String            @db.Uuid
  amount              Decimal           @db.Decimal(12, 2)
  effective_from      DateTime          @db.Date
  effective_to        DateTime?         @db.Date
  created_at          DateTime          @default(now())
  updated_at          DateTime          @default(now())
  employees           employees         @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  salary_components   salary_components @relation(fields: [salary_component_id], references: [id], onDelete: Cascade)

  @@index([employee_id, effective_from])
  @@index([salary_component_id])
}

model employees {
  id                             String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_code                  String                       @unique
  full_name                      String
  profile_photo_url              String?
  date_of_birth                  DateTime?                    @db.Date
  gender                         String?
  marital_status                 String?
  nationality                    String?
  blood_group                    String?
  personal_email                 String?
  work_email                     String?
  phone                          String?
  alternate_phone                String?
  present_address                String?
  permanent_address              String?
  emergency_contact_name         String?
  emergency_contact_relationship String?
  emergency_contact_phone        String?
  joining_date                   DateTime                     @db.Date
  employment_type                EmploymentType?
  employment_status              EmploymentStatus             @default(ACTIVE)
  department_id                  String?                      @db.Uuid
  designation_id                 String?                      @db.Uuid
  shift_id                       String?                      @db.Uuid
  reporting_manager_id           String?                      @db.Uuid
  resignation_date               DateTime?                    @db.Date
  termination_date               DateTime?                    @db.Date
  exit_reason                    String?
  user_id                        String?                      @unique @db.Uuid
  created_at                     DateTime                     @default(now())
  updated_at                     DateTime
  deleted_at                     DateTime?
  bank_account_name              String?
  bank_account_number            String?
  bank_name                      String?
  bank_routing_number            String?
  mobile_banking_number          String?
  mobile_banking_provider        String?
  payment_method                 String                       @default("BANK_TRANSFER")
  attendance_adjustments         attendance_adjustments[]
  attendance_records             attendance_records[]
  biometric_logs                 biometric_logs[]
  employee_documents             employee_documents[]
  employee_leave_balances        employee_leave_balances[]
  employee_salaries              employee_salaries[]
  employee_salary_components     employee_salary_components[]
  departments                    departments?                 @relation(fields: [department_id], references: [id])
  designations                   designations?                @relation(fields: [designation_id], references: [id])
  employees                      employees?                   @relation("employeesToemployees", fields: [reporting_manager_id], references: [id])
  other_employees                employees[]                  @relation("employeesToemployees")
  shifts                         shifts?                      @relation(fields: [shift_id], references: [id])
  users                          users?                       @relation(fields: [user_id], references: [id])
  leave_requests                 leave_requests[]
  payroll_records                payroll_records[]

  @@index([deleted_at])
  @@index([department_id])
  @@index([designation_id])
  @@index([employment_status])
  @@index([reporting_manager_id])
  @@index([shift_id])
}

model holidays {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date                DateTime @db.Date
  name                String
  is_recurring_yearly Boolean  @default(false)
  created_at          DateTime @default(now())
  updated_at          DateTime @default(now())

  @@index([date])
}

model leave_requests {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id      String      @db.Uuid
  leave_type_id    String      @db.Uuid
  start_date       DateTime    @db.Date
  end_date         DateTime    @db.Date
  total_days       Decimal     @db.Decimal(5, 2)
  reason           String?
  attachment_url   String?
  status           LeaveStatus @default(PENDING)
  reviewed_by      String?     @db.Uuid
  reviewed_at      DateTime?
  review_note      String?
  created_at       DateTime    @default(now())
  updated_at       DateTime
  half_day_session String?
  is_half_day      Boolean     @default(false)
  employees        employees   @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  leave_types      leave_types @relation(fields: [leave_type_id], references: [id])
  users            users?      @relation(fields: [reviewed_by], references: [id])

  @@index([employee_id, status])
  @@index([leave_type_id])
  @@index([start_date, end_date])
  @@index([status])
}

model leave_types {
  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                    String                    @unique
  description             String?
  days_per_year           Decimal?                  @db.Decimal(5, 2)
  is_paid                 Boolean                   @default(true)
  is_active               Boolean                   @default(true)
  created_at              DateTime                  @default(now())
  updated_at              DateTime
  employee_leave_balances employee_leave_balances[]
  leave_requests          leave_requests[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model payroll_items {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payroll_record_id String          @db.Uuid
  name              String
  type              ComponentType
  amount            Decimal         @db.Decimal(12, 2)
  description       String?
  created_at        DateTime        @default(now())
  payroll_records   payroll_records @relation(fields: [payroll_record_id], references: [id], onDelete: Cascade)

  @@index([payroll_record_id])
}

model payroll_periods {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  year            Int
  month           Int
  start_date      DateTime            @db.Date
  end_date        DateTime            @db.Date
  status          PayrollPeriodStatus @default(DRAFT)
  processed_at    DateTime?
  processed_by    String?             @db.Uuid
  created_at      DateTime            @default(now())
  updated_at      DateTime            @default(now())
  users           users?              @relation(fields: [processed_by], references: [id])
  payroll_records payroll_records[]

  @@unique([year, month])
  @@index([status])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model payroll_records {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payroll_period_id String          @db.Uuid
  employee_id       String          @db.Uuid
  basic_salary      Decimal         @default(0) @db.Decimal(12, 2)
  total_earnings    Decimal         @default(0) @db.Decimal(12, 2)
  total_deductions  Decimal         @default(0) @db.Decimal(12, 2)
  overtime_amount   Decimal         @default(0) @db.Decimal(12, 2)
  bonus_amount      Decimal         @default(0) @db.Decimal(12, 2)
  net_salary        Decimal         @default(0) @db.Decimal(12, 2)
  payment_status    PaymentStatus   @default(PENDING)
  paid_at           DateTime?
  created_at        DateTime        @default(now())
  updated_at        DateTime
  disbursed_by_id   String?         @db.Uuid
  payment_method    String?
  payment_note      String?
  payment_reference String?
  payroll_items     payroll_items[]
  users             users?          @relation(fields: [disbursed_by_id], references: [id])
  employees         employees       @relation(fields: [employee_id], references: [id])
  payroll_periods   payroll_periods @relation(fields: [payroll_period_id], references: [id], onDelete: Cascade)
  payslips          payslips?

  @@unique([payroll_period_id, employee_id])
  @@index([employee_id])
  @@index([payment_status])
  @@index([payroll_period_id])
}

model payslips {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payroll_record_id String          @unique @db.Uuid
  payslip_number    String          @unique
  file_url          String?
  generated_at      DateTime        @default(now())
  payroll_records   payroll_records @relation(fields: [payroll_record_id], references: [id], onDelete: Cascade)
}

model permissions {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key              String             @unique
  group            String
  description      String?
  role_permissions role_permissions[]
}

model role_permissions {
  role_id       String      @db.Uuid
  permission_id String      @db.Uuid
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade)
  roles         roles       @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
}

model roles {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String             @unique
  description      String?
  is_system        Boolean            @default(false)
  created_at       DateTime           @default(now())
  updated_at       DateTime
  role_permissions role_permissions[]
  users            users[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model salary_components {
  id                         String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                       String                       @unique
  component_type             ComponentType
  calculation_type           CalculationType              @default(FIXED)
  default_amount             Decimal                      @default(0) @db.Decimal(12, 2)
  is_active                  Boolean                      @default(true)
  created_at                 DateTime                     @default(now())
  updated_at                 DateTime                     @default(now())
  employee_salary_components employee_salary_components[]
}

model sessions {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_token String   @unique
  user_id       String   @db.Uuid
  expires       DateTime
  users         users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model shifts {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String
  start_time            DateTime             @db.Time(6)
  end_time              DateTime             @db.Time(6)
  grace_period_minutes  Int                  @default(0)
  required_work_minutes Int?
  break_minutes         Int                  @default(0)
  is_overnight          Boolean              @default(false)
  is_active             Boolean              @default(true)
  created_at            DateTime             @default(now())
  updated_at            DateTime
  attendance_records    attendance_records[]
  employees             employees[]
}

model users {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                  String                   @unique
  password_hash          String
  role_id                String                   @db.Uuid
  status                 UserStatus               @default(ACTIVE)
  last_login_at          DateTime?
  created_at             DateTime                 @default(now())
  updated_at             DateTime
  accounts               accounts[]
  attendance_adjustments attendance_adjustments[]
  audit_logs             audit_logs[]
  employees              employees?
  leave_requests         leave_requests[]
  payroll_periods        payroll_periods[]
  payroll_records        payroll_records[]
  sessions               sessions[]
  roles                  roles                    @relation(fields: [role_id], references: [id])

  @@index([role_id])
  @@index([status])
}

model verification_tokens {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum AttendanceSource {
  BIOMETRIC
  MANUAL
  SYSTEM
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  LEAVE
  HOLIDAY
  WEEKEND
}

enum CalculationType {
  FIXED
  PERCENTAGE
}

enum ComponentType {
  EARNING
  DEDUCTION
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  RESIGNED
  TERMINATED
  INACTIVE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PaymentFrequency {
  MONTHLY
  BIWEEKLY
  WEEKLY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum PayrollPeriodStatus {
  DRAFT
  PROCESSING
  COMPLETED
  LOCKED
  CALCULATED
  APPROVED
  PAID
}

enum PunchType {
  CHECK_IN
  CHECK_OUT
  UNKNOWN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}
